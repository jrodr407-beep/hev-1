<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hev_background"
    android:orientation="horizontal"
    tools:context=".MainActivity">

    <!-- Left Panel: HEV Suit Image -->
    <ImageView
        android:id="@+id/hevSuitImage"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scaleType="centerInside"
        android:src="@drawable/neon_orange_lambda_armor_blueprint"
        android:contentDescription="HEV Suit" />

    <!-- Right Panel: Buttons -->
    <LinearLayout
        android:id="@+id/buttonPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="3">

            <!-- Button 1 -->
            <Button
                android:id="@+id/buttonMarkIV"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_margin="8dp"
                android:background="@drawable/hev_button_bg"
                android:padding="8dp"
                android:text="1"
                android:textColor="@color/hev_green"
                android:textSize="32sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <!-- Button 2 -->
            <Button
                android:id="@+id/buttonLacerations"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_margin="8dp"
                android:background="@drawable/hev_button_bg"
                android:padding="8dp"
                android:text="2"
                android:textColor="@color/hev_green"
                android:textSize="32sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <!-- Button 3 -->
            <Button
                android:id="@+id/buttonFracture"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_margin="8dp"
                android:background="@drawable/hev_button_bg"
                android:padding="8dp"
                android:text="3"
                android:textColor="@color/hev_green"
                android:textSize="32sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <!-- Button 4 -->
            <Button
                android:id="@+id/buttonDeathImminent"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_margin="8dp"
                android:background="@drawable/hev_button_bg"
                android:padding="8dp"
                android:text="4"
                android:textColor="@color/hev_green"
                android:textSize="32sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <!-- Button 5 -->
            <Button
                android:id="@+id/buttonBeep"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_margin="8dp"
                android:background="@drawable/hev_button_bg"
                android:padding="8dp"
                android:text="5"
                android:textColor="@color/hev_green"
                android:textSize="32sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <!-- View Toggle Button -->
            <Button
                android:id="@+id/viewToggle"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_margin="8dp"
                android:background="@drawable/hev_button_bg"
                android:padding="8dp"
                android:text="HELM"
                android:textColor="@color/hev_green"
                android:textSize="16sp"
                android:textStyle="bold"
                android:typeface="monospace" />

        </GridLayout>

    </LinearLayout>

    <!-- Toggle Button (hidden in landscape) -->
    <Button
        android:id="@+id/toggleButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
