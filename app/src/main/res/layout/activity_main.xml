<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hev_background"
    tools:context=".MainActivity">

    <!-- 3D Model WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Toggle Button -->
    <Button
        android:id="@+id/toggleButton"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_margin="16dp"
        android:background="@drawable/hev_button_bg"
        android:text="☰"
        android:textColor="@color/hev_green"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Button Panel (initially hidden) -->
    <LinearLayout
        android:id="@+id/buttonPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_toEndOf="@id/toggleButton"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="8dp">

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">

            <!-- Button 1 -->
            <Button
                android:id="@+id/buttonMarkIV"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="4dp"
                android:background="@drawable/hev_button_bg"
                android:padding="8dp"
                android:text="1"
                android:textColor="@color/hev_green"
                android:textSize="24sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <!-- Button 2 -->
            <Button
                android:id="@+id/buttonLacerations"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="4dp"
                android:background="@drawable/hev_button_bg"
                android:padding="8dp"
                android:text="2"
                android:textColor="@color/hev_green"
                android:textSize="24sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <!-- Button 3 -->
            <Button
                android:id="@+id/buttonFracture"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="4dp"
                android:background="@drawable/hev_button_bg"
                android:padding="8dp"
                android:text="3"
                android:textColor="@color/hev_green"
                android:textSize="24sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <!-- Button 4 -->
            <Button
                android:id="@+id/buttonDeathImminent"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="4dp"
                android:background="@drawable/hev_button_bg"
                android:padding="8dp"
                android:text="4"
                android:textColor="@color/hev_green"
                android:textSize="24sp"
                android:textStyle="bold"
                android:typeface="monospace" />

        </GridLayout>

    </LinearLayout>

</RelativeLayout>
