<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hev_background"
    tools:context=".MainActivity">

    <!-- HEV Suit Background Image -->
    <ImageView
        android:id="@+id/hevSuitImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/neon_orange_lambda_armor_blueprint"
        android:contentDescription="HEV Suit" />

    <!-- Button Grid Overlay -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:columnCount="2"
        android:rowCount="2"
        android:padding="32dp">

        <!-- Button 1: HEV Mark IV -->
        <Button
            android:id="@+id/buttonMarkIV"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/hev_button_bg"
            android:padding="16dp"
            android:text="HEV MARK IV"
            android:textColor="@color/hev_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <!-- Button 2: Minor Lacerations -->
        <Button
            android:id="@+id/buttonLacerations"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/hev_button_bg"
            android:padding="16dp"
            android:text="MINOR LACERATIONS"
            android:textColor="@color/hev_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <!-- Button 3: Major Fracture -->
        <Button
            android:id="@+id/buttonFracture"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/hev_button_bg"
            android:padding="16dp"
            android:text="MAJOR FRACTURE"
            android:textColor="@color/hev_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <!-- Button 4: Death Imminent -->
        <Button
            android:id="@+id/buttonDeathImminent"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/hev_button_bg"
            android:padding="16dp"
            android:text="DEATH IMMINENT"
            android:textColor="@color/hev_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:typeface="monospace" />

    </GridLayout>

</RelativeLayout>
