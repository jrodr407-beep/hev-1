<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hev_background">

    <!-- Loading Screen Image -->
    <ImageView
        android:id="@+id/screensaverImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/loading_screen"
        android:contentDescription="Screensaver" />

    <!-- Time Display -->
    <TextView
        android:id="@+id/timeDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="00:00"
        android:textColor="@color/hev_green"
        android:textSize="72sp"
        android:textStyle="bold"
        android:typeface="monospace" />

    <!-- Close Button -->
    <Button
        android:id="@+id/closeScreensaver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_margin="32dp"
        android:background="@drawable/hev_button_bg"
        android:padding="16dp"
        android:text="EXIT"
        android:textColor="@color/hev_green"
        android:textSize="18sp"
        android:textStyle="bold"
        android:typeface="monospace" />

</RelativeLayout>
